<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Levia" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/levia_violet</item>
        <item name="colorPrimaryVariant">@color/levia_dark_purple</item>
        <item name="colorOnPrimary">@color/levia_white</item>
        <item name="colorSecondary">@color/levia_lavender</item>
        <item name="colorOnSecondary">@color/levia_black</item>
        <item name="colorSurface">@color/levia_surface</item>
        <item name="colorOnSurface">@color/levia_white</item>
        <item name="android:windowBackground">@color/levia_black</item>
        <item name="android:statusBarColor">@color/levia_black</item>
        <item name="android:navigationBarColor">@color/levia_black</item>
    </style>

    <style name="LeviaButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/levia_violet</item>
        <item name="android:textColor">@color/levia_white</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="LeviaInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/levia_lavender</item>
        <item name="hintTextColor">@color/levia_lavender</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>
</resources>
