# Copy to .env for local use. NEVER commit .env. On Render, set these in the dashboard.
NODE_ENV=development
PORT=3000
# Supabase: Project Settings > Database > Connection string (use the pooler URI)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-64-random-hex-chars-minimum-32
REFRESH_TOKEN_DAYS=30
# Comma-separated origins allowed for the admin web app (the Android app does not need CORS)
CORS_ORIGINS=http://localhost:5173
# Public base URL used in password reset links
APP_BASE_URL=https://your-service.onrender.com
# Optional SMTP for password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LEVIA <no-reply@example.com>
